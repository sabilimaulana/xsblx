# Copy to `.env.test`. Must point at a database you do not mind losing: the test
# run truncates every table in the `public` schema before each test (ADR 0004).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xsblx_test

# Avatar tests write real objects to the SeaweedFS from `docker compose up -d`.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=xsblx
