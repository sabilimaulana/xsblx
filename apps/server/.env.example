PORT=3000
# Processes sharing the port via SO_REUSEPORT. 1, a positive integer, or "auto"
# (every core). Linux only — macOS does not balance across workers.
WORKERS=1
DATABASE_URL=postgres://user:password@localhost:5432/xsblx

AUTH_URL=http://localhost:3000
AUTH_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Observability (ADR 0015). Empty endpoint exports nothing; spans and metrics are
# still produced and dropped. `docker compose --profile otel up -d` runs
# otel-lgtm, which takes OTLP on 4318 and serves Grafana on 3002.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=xsblx-server
LOG_LEVEL=Info
LOG_FORMAT=pretty

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=xsblx
# Only needed when the endpoint above is not reachable from the browser.
S3_PUBLIC_URL=http://localhost:8333
