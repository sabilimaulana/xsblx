# `alchemy` reads this file from the workspace root, not here — the values below
# are the Worker's own configuration, resolved in its init phase and bound as
# secrets at deploy time. Copy the ones you need into the root `.env`.

# yielded-auth keyrings (ADR 0030): 32 random bytes each, base64url, no padding.
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AUTH_PROOF_KEY=
AUTH_BINDING_KEY=

# Comma-separated, never a wildcard (ADR 0008). Under `alchemy dev` this is the
# local website; after a deploy it is the deployed website's URL.
CORS_ALLOWED_ORIGINS=http://localhost:3001
