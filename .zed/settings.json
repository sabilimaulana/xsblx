{
  // Vendored repos are reference material for coding agents, not part of the
  // app. Keep them out of Zed's scans, search, and project panel.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "repos/**"
  ],

  // oxlint diagnostics. Requires the "oxc" extension (Zed: Extensions -> oxc).
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}", "--disable-nested-config"]
        }
      }
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}", "--disable-nested-config"]
        }
      }
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}", "--disable-nested-config"]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}", "--disable-nested-config"]
        }
      }
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}", "--disable-nested-config"]
        }
      }
    }
  },
  "format_on_save": "on"
}
