# Read by `docker compose` only. The apps keep their own `.env` files for
# `bun dev` on the host — this file configures the containers.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xsblx
POSTGRES_PORT=5432

# Required by the `app` profile. Generate one: `openssl rand -base64 32`
AUTH_SECRET=

SERVER_PORT=3000
WEB_PORT=3001
AUTH_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001
VITE_API_URL=http://localhost:3000
