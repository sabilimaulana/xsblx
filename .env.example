# Read by `docker compose` only. The apps keep their own `.env` files for
# `bun dev` on the host — this file configures the containers.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xsblx
POSTGRES_PORT=5432

# Required by the `app` profile. Generate one: `openssl rand -base64 32`
AUTH_SECRET=

SERVER_PORT=3000
WEB_PORT=3001
AUTH_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001
VITE_API_URL=http://localhost:3000

# Observability (ADR 0015). Leave the endpoint empty to export nothing.
# With `docker compose --profile otel up -d`, use http://otel:4318 and read
# traces, metrics and logs in Grafana on http://localhost:3002.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=xsblx-server
LOG_LEVEL=Info
LOG_FORMAT=json

# Object store (ADR 0018). SeaweedFS is configured with these at startup; the
# server signs its writes with them. Any string works locally.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=xsblx
S3_PORT=8333
# The origin a browser uses for avatar URLs — the host mapping, not `seaweedfs`.
S3_PUBLIC_URL=http://localhost:8333
