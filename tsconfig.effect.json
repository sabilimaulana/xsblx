{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  // Shared @effect/language-service severities. Every workspace that uses Effect
  // extends this so a rule is configured once, not per app.
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          // correctness — these are bugs
          "floatingEffect": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "missingStarInYieldEffectGen": "error",
          "missingReturnYieldStar": "error",
          "returnEffectInGen": "error",
          "effectInVoidSuccess": "error",
          "promiseInEffectSuccess": "error",
          "outdatedApi": "error",
          "classSelfMismatch": "error",
          "effectFnImplicitAny": "error",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "duplicatePackage": "error",
          // effect-native preset — repo policy is "Effect for everything effectful"
          "abortControllerInEffect": "error",
          "asyncFunction": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "extendsNativeError": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "instanceOfSchema": "error",
          "newPromise": "error",
          "nodeBuiltinImport": "error",
          "preferSchemaOverJson": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "tryCatchInEffectGen": "error",
          // style — suggestions only, never block typecheck
          "missedPipeableOpportunity": "off",
          "unnecessaryArrowBlock": "off",
          "effectFnOpportunity": "off",
          "lazyEffect": "off",
          "strictBooleanExpressions": "off"
        },
        "overrides": [
          {
            // config files and entry-point boot run outside the Effect runtime.
            // Patterns resolve from the *consuming* tsconfig's directory, so
            // keep them recursive and workspace-relative.
            "include": ["**/*.config.ts", "**/drizzle.config.ts"],
            "options": {
              "diagnosticSeverity": {
                "processEnv": "off",
                "globalConsole": "off"
              }
            }
          },
          {
            // React/TanStack callbacks (route loaders, form onSubmit) are async
            // by API contract; Effect only enters apps/web through runApi.
            "include": ["**/*.tsx", "**/routes/**"],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "off",
                "newPromise": "off"
              }
            }
          }
        ]
      }
    ]
  }
}
