{
  "name": "xsblx",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@cloudflare/workers-types": "^5.20260918.1",
      "@types/node": "^22.10.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "lucide-react": "^1.30.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tailwindcss": "^4.1.18",
      "typescript": "^7.0.2",
      "vite": "^8.0.0"
    },
    "catalogs": {
      "alchemy": {
        "alchemy": "2.0.0-beta.80"
      },
      "effect": {
        "@effect/platform-bun": "4.0.0",
        "@effect/platform-node": "4.0.0",
        "@effect/sql-d1": "4.0.0",
        "@effect/vitest": "4.0.0",
        "effect": "4.0.0"
      }
    }
  },
  "scripts": {
    "prepare": "lefthook install && effect-tsgo patch --typescript --no-oxlint",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy --stage dev_$USER",
    "deploy:prod": "set -a && . ./.env && set +a && alchemy deploy --stage prod --env-file .env.prod.local",
    "destroy": "alchemy destroy --stage dev_$USER",
    "plan": "alchemy plan --stage dev_$USER",
    "tail": "alchemy logs --tail --stage dev_$USER",
    "build": "bun run --filter web build",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun test .e2e.test.ts --path-ignore-patterns 'repos/**'",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "@effect/tsgo": "0.45.0",
    "@types/bun": "latest",
    "alchemy": "catalog:alchemy",
    "drizzle-kit": "catalog:",
    "effect": "catalog:effect",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.83.0",
    "typescript": "catalog:"
  }
}
