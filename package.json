{
  "name": "xsblx",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^22.10.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "lucide-react": "^1.30.0",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "tailwindcss": "^4.1.18",
      "typescript": "^7.0.2",
      "vite": "^8.0.0"
    },
    "catalogs": {
      "effect": {
        "@effect/platform-bun": "4.0.0-beta.103",
        "@effect/sql-pg": "4.0.0-beta.103",
        "@effect/vitest": "4.0.0-beta.103",
        "effect": "4.0.0-beta.103"
      }
    }
  },
  "scripts": {
    "prepare": "lefthook install && effect-tsgo patch --typescript --no-oxlint",
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "build": "bun run --filter web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "catalog:"
  }
}
