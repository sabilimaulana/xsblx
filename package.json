{
  "name": "xsblx",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@cloudflare/workers-types": "^4.20250805.0",
      "@types/node": "^22.10.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "lucide-react": "^1.30.0",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "tailwindcss": "^4.1.18",
      "typescript": "^7.0.2",
      "vite": "^8.0.0"
    },
    "catalogs": {
      "alchemy": {
        "@alchemy.run/better-auth": "https://pkg.ing/@alchemy.run/better-auth/e05c734ea30625efd07a443cef267bfde225f5b4",
        "alchemy": "https://pkg.ing/alchemy/e05c734ea30625efd07a443cef267bfde225f5b4"
      },
      "auth": {
        "@better-auth/drizzle-adapter": "1.7.2",
        "better-auth": "1.7.2"
      },
      "effect": {
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112",
        "@effect/sql-d1": "4.0.0-rc.112",
        "@effect/vitest": "4.0.0-rc.112",
        "effect": "4.0.0-rc.112"
      }
    }
  },
  "scripts": {
    "prepare": "lefthook install && effect-tsgo patch --typescript --no-oxlint",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "deploy:prod": "set -a && . ./.env && set +a && alchemy deploy --stage prod --env-file .env.prod.local",
    "destroy": "alchemy destroy",
    "plan": "alchemy plan",
    "tail": "alchemy tail",
    "build": "bun run --filter web build",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter server test:e2e",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "@effect/tsgo": "0.40.0",
    "@types/bun": "latest",
    "alchemy": "catalog:alchemy",
    "drizzle-kit": "catalog:",
    "effect": "catalog:effect",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "catalog:"
  }
}
